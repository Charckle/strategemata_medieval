[node name="fullscreen_btn" type="OptionButton" parent="overlays/settings_pan/margin/vbox/tabs/Video/content/fullscreen_row"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
item_count = 2
popup/item_0/text = "Off"
popup/item_0/id = 0
popup/item_1/text = "On"
popup/item_1/id = 1

[node name="Gameplay" type="VBoxContainer" parent="overlays/settings_pan/margin/vbox/tabs"]
layout_mode = 2

[node name="placeholder" type="Label" parent="overlays/settings_pan/margin/vbox/tabs/Gameplay"]
layout_mode = 2
text = "No gameplay settings yet."

[node name="back_btn" type="Button" parent="overlays/settings_pan/margin/vbox"]
layout_mode = 2
text = "Back"

[connection signal="pressed" from="center/panel/buttons/continue_btn" to="center/panel/buttons" method="_on_continue_btn_pressed"]
[connection signal="pressed" from="center/panel/buttons/new_game_btn" to="center/panel/buttons" method="_on_new_game_btn_pressed"]
[connection signal="pressed" from="center/panel/buttons/load_game_btn" to="center/panel/buttons" method="_on_load_game_btn_pressed"]
[connection signal="pressed" from="center/panel/buttons/settings_btn" to="center/panel/buttons" method="_on_settings_btn_pressed"]
[connection signal="pressed" from="center/panel/buttons/exit_btn" to="center/panel/buttons" method="_on_exit_btn_pressed"]
[connection signal="value_changed" from="overlays/settings_pan/margin/vbox/tabs/Audio/content/master_row/master_slider" to="overlays/settings_pan" method="_on_master_slider_value_changed"]
[connection signal="value_changed" from="overlays/settings_pan/margin/vbox/tabs/Audio/content/sfx_row/sfx_slider" to="overlays/settings_pan" method="_on_sfx_slider_value_changed"]
[connection signal="value_changed" from="overlays/settings_pan/margin/vbox/tabs/Audio/content/music_row/music_slider" to="overlays/settings_pan" method="_on_music_slider_value_changed"]
[connection signal="item_selected" from="overlays/settings_pan/margin/vbox/tabs/Audio/content/music_on_off_row/music_on_off_btn" to="overlays/settings_pan" method="_on_music_on_off_btn_item_selected"]
[connection signal="item_selected" from="overlays/settings_pan/margin/vbox/tabs/Audio/content/sfx_on_off_row/sfx_on_off_btn" to="overlays/settings_pan" method="_on_sfx_on_off_btn_item_selected"]
[connection signal="item_selected" from="overlays/settings_pan/margin/vbox/tabs/Video/content/fullscreen_row/fullscreen_btn" to="overlays/settings_pan" method="_on_fullscreen_btn_item_selected"]
[connection signal="pressed" from="overlays/settings_pan/margin/vbox/back_btn" to="overlays/settings_pan" method="_on_back_btn_pressed"]
